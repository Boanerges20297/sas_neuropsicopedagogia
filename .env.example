# ==================== CONFIGURAÇÕES DE AMBIENTE (SaS_NeuroPsicopedagogia) ====================
# Copie este arquivo para .env e ajuste os valores conforme necessário.
# NUNCA envie o arquivo .env para o controle de versão Git!

# 🔑 Configurações do Django
DEBUG_MODE=True
SECRET_KEY=django-insecure-sua-chave-secreta-aqui
ALLOWED_HOSTS=*
USE_SQLITE=True

# 💾 Configurações do Banco de Dados MySQL
DB_NAME=sas_neuropsicopedagogia_db
DB_USER=sas_user
DB_PASSWORD=sua_senha_segura
DB_HOST=localhost
DB_PORT=3306

# 🧠 Configurações do Microsserviço de IA
AI_SERVICE_URL=http://localhost:5001

# 👤 Credenciais do Admin Inicial (Criado nas migrações)
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administradora
