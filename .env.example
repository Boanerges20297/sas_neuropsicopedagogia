# ==================== EXEMPLO DE CONFIGURAÇÃO ====================
# Copie este arquivo para .env e ajuste os valores conforme necessário
# NUNCA compartilhe o arquivo .env em repositórios públicos!

# Configurações do Flask
SECRET_KEY=
# Gere uma chave aleatoria: python -c "import secrets; print(secrets.token_urlsafe(48))"

# Configurações do Banco de Dados
DATABASE_NAME=app_database.db

# Credenciais do Admin Inicial
# ADMIN_EMAIL=admin@seu-dominio.com
# ADMIN_PASSWORD=<senha_aleatoria_de_12_ou_mais_caracteres>
ADMIN_NAME=Seu Nome Completo

# Configurações da Aplicação
DEBUG_MODE=False
HOST=127.0.0.1
PORT=5000

# ==================== INSTRUÇÕES ====================
# 1. Para gerar uma SECRET_KEY segura, execute no terminal:
#    python -c "import secrets; print(secrets.token_hex(32))"
#
# 2. Altere ADMIN_PASSWORD para uma senha forte e única
#
# 3. Em produção, mude DEBUG_MODE para False
#
# 4. Configure HOST como 0.0.0.0 para acesso externo (somente em produção segura)

# Superadministrador (bootstrap opcional e sem senha hardcoded)
# Configure as DUAS linhas abaixo somente para criar a primeira conta.
# SUPERADMIN_EMAIL=superadmin@seu-dominio.com
# SUPERADMIN_PASSWORD=<senha aleatoria de pelo menos 16 caracteres>
# A conta existente nunca tem sua senha redefinida pelo bootstrap.
# Apos trocar a senha no primeiro login, remova AMBAS do seu .env.
