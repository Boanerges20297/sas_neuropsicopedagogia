# ==================== EXEMPLO DE CONFIGURAÇÃO ====================
# Copie este arquivo para .env e ajuste os valores conforme necessário
# NUNCA compartilhe o arquivo .env em repositórios públicos!

# Configurações do Flask
SECRET_KEY=sua-chave-secreta-super-segura-aqui

# Configurações do Banco de Dados
DATABASE_NAME=app_database.db

# Credenciais do Admin Inicial
ADMIN_EMAIL=seu-email@dominio.com
ADMIN_PASSWORD=sua-senha-forte-aqui
ADMIN_NAME=Seu Nome Completo

# Configurações da Aplicação
DEBUG_MODE=True
HOST=127.0.0.1
PORT=5000

# ==================== INSTRUÇÕES ====================
# 1. Para gerar uma SECRET_KEY segura, execute no terminal:
#    python -c "import secrets; print(secrets.token_hex(32))"
#
# 2. Altere ADMIN_PASSWORD para uma senha forte e única
#
# 3. Em produção, mude DEBUG_MODE para False
#
# 4. Configure HOST como 0.0.0.0 para acesso externo (somente em produção segura)
