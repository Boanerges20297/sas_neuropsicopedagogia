#!/usr/bin/env bash
set -Eeuo pipefail
# This is source-only until installed via an independently approved bootstrap.
ORIGINAL="${SSH_ORIGINAL_COMMAND:-}"
STATE=/var/lib/neuro-diagnosis/deployed-sha
if [[ "$ORIGINAL" =~ ^deploy\ ([0-9a-f]{40})$ ]]; then
  exec sudo /usr/local/sbin/deploy-neuro-diagnosis "${BASH_REMATCH[1]}"
fi
if [[ "$ORIGINAL" =~ ^smoke\ ([0-9a-f]{40})$ ]]; then
  expected="${BASH_REMATCH[1]}"
  [[ -r "$STATE" ]] || exit 1
  actual="$(tr -d '\r\n' < "$STATE")"
  [[ "$expected" == "$actual" ]] || exit 1
  curl --fail --silent --show-error --max-time 5 http://127.0.0.1:8781/health/live >/dev/null
  curl --fail --silent --show-error --max-time 5 http://127.0.0.1:8781/health/ready >/dev/null
  printf 'NEURO_SMOKE_OK %s\n' "$actual"
  exit 0
fi
echo "NEURO_GATEWAY_DENIED" >&2
exit 126
